# Optional host bind mounts for Docker Compose data.
# When unset, compose falls back to the original named volumes.

GOCHAT_MYSQL_DATA=D:/develop/docker_workspace/gochat/mysql
GOCHAT_REDIS_DATA=D:/develop/docker_workspace/gochat/redis
GOCHAT_BACKEND_LOGS=D:/develop/docker_workspace/gochat/logs
GOCHAT_BACKEND_AVATARS=D:/develop/docker_workspace/gochat/avatars
GOCHAT_BACKEND_FILES=D:/develop/docker_workspace/gochat/files
GOCHAT_SMS_ACCESS_KEY_ID=
GOCHAT_SMS_ACCESS_KEY_SECRET=
GOCHAT_SMS_SIGN_NAME=
GOCHAT_SMS_TEMPLATE_CODE=
GOCHAT_SMS_SCHEME_NAME=
GOCHAT_SMS_COUNTRY_CODE=86
GOCHAT_SMS_CODE_LENGTH=6
GOCHAT_SMS_VALID_TIME=300
GOCHAT_SMS_DUPLICATE_POLICY=1
GOCHAT_SMS_INTERVAL=60
GOCHAT_SMS_CODE_TYPE=1
GOCHAT_SMS_CASE_AUTH_POLICY=1
GOCHAT_SMS_RETURN_VERIFY_CODE=false
GOCHAT_SMS_AUTO_RETRY=1
