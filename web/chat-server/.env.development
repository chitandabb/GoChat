# 后端地址不再写死：由 src/store/index.js 按当前页面 hostname 自动推导
# （页面从哪个 host 打开，API/WS 就打哪个 host 的 8000 端口：
#   localhost:8080 -> localhost:8000，局域网 IP:8080 -> 同 IP:8000）。
# 如需强制指定，取消下面两行注释并填写。
# VUE_APP_API_BASE_URL=http://localhost:8000
# VUE_APP_WS_BASE_URL=ws://localhost:8000
DEV_SERVER_HTTPS=false
DEV_SERVER_HOST=0.0.0.0
DEV_SERVER_PORT=8080